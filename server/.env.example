PORT=5000
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/bloodfinder
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:5173
# Optional: email (if empty, emails are printed to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: SMS via Fast2SMS (if empty, SMS is printed to the console)
FAST2SMS_KEY=
